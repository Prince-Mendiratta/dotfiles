<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for dotfiles/bin/shot-watch (screenshot → remote-dev:~/shots).
     Install: cp to ~/Library/LaunchAgents/ then `launchctl load` it.
     Paths must be ABSOLUTE here — launchd does not expand ~ inside <string>. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.prince.shot-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/princemendiratta/dotfiles/bin/shot-watch</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/shot-watch.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/shot-watch-error.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/princemendiratta</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
