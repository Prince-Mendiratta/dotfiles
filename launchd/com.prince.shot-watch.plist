<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for dotfiles/bin/shot-watch (screenshot → remote-dev:~/shots).
     This is a TEMPLATE: launchd does not expand ~ or $HOME, so
     __HOME__ / __DOTFILES_DIR__ are filled in at install time. Install with:
       INSTALL_SHOT_WATCH=1 ./install.sh -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.prince.shot-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DOTFILES_DIR__/bin/shot-watch</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/shot-watch.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/shot-watch-error.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
