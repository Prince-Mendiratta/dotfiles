#!/usr/bin/env zsh
# remote-connect — pick a host from your ssh config and open a tmux session over et, mosh or ssh.
#
# Used by the single iTerm2 "Remote" dynamic profile so ONE profile serves every
# machine. The picker runs LOCALLY (before the connection takes over the terminal), so it
# can set the iTerm badge/title to the chosen host — that's why the one red
# profile shows e.g. "REMOTE · remote-dev" once connected.
#
# Host list is derived from your ssh config, so new hosts appear automatically.
set -euo pipefail

# --- gather candidate hosts from ssh config + included inventory -------------
config_files=("$HOME/.ssh/config" "$HOME/.ssh/icloud-hosts")
hosts=()
for f in "${config_files[@]}"; do
  [[ -r "$f" ]] || continue
  while read -r _ rest; do
    for h in ${(z)rest}; do
      # skip wildcard/negated patterns — they aren't real connectable hosts
      [[ "$h" == *"*"* || "$h" == *"?"* || "$h" == "!"* ]] && continue
      hosts+=("$h")
    done
  done < <(grep -iE '^[[:space:]]*Host[[:space:]]' "$f")
done
# de-duplicate, keep order
typeset -U hosts

if (( ${#hosts} == 0 )); then
  print -u2 "remote-connect: no hosts found in ssh config"
  exit 1
fi

# --- choose a host ----------------------------------------------------------
host=""
if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
  host=$(printf '%s\n' "${hosts[@]}" | fzf --prompt="remote ❯ " --height=40% --reverse --no-multi) || true
else
  print "Select a remote host:"
  select choice in "${hosts[@]}"; do
    [[ -n "${choice:-}" ]] && host="$choice" && break
  done
fi

[[ -z "$host" ]] && { print "No host selected."; exit 0; }

# --- clear any stale iTerm badge; set the tab title to the chosen host -------
# (the Remote profile no longer renders a badge, so make sure none lingers)
if [[ "${TERM_PROGRAM:-}" == "iTerm.app" ]]; then
  printf '\e]1337;SetBadgeFormat=\a'
fi
printf '\033]0;%s\007' "$host"   # tab/window title

# --- connect + attach-or-create a persistent tmux session -------------------
# Transport: REMOTE_TRANSPORT=et|mosh|ssh, else auto: `et` (Eternal Terminal)
# if installed locally, otherwise plain ssh (works on any host). et needs
# `etserver` on the remote; mosh needs mosh-server + UDP 60000-61000 open.
transport="${REMOTE_TRANSPORT:-}"
if [[ -z "$transport" ]]; then
  if command -v et >/dev/null 2>&1; then transport=et; else transport=ssh; fi
fi

# Fall back to a login shell on hosts without tmux.
remote_cmd='command -v tmux >/dev/null 2>&1 && exec tmux -CC new -A -s main || exec "$SHELL" -l'

# On failure, keep the window open so the error is readable — otherwise iTerm
# closes the tab instantly and you see nothing.
fail() {
  print -u2 "\nremote-connect: $1"
  read -rs -k1 '?Press any key to close…'
  exit 1
}

case "$transport" in
  et)
    command -v et >/dev/null 2>&1 || fail "et not installed (brew install MisterTea/et/et), or set REMOTE_TRANSPORT=ssh"
    et "$host" -c "$remote_cmd" || fail "et to $host failed (is etserver running on it?). Try REMOTE_TRANSPORT=ssh"
    ;;
  mosh)
    # tmux control mode (-CC) doesn't work over mosh; use plain tmux.
    mosh "$host" -- sh -c 'command -v tmux >/dev/null 2>&1 && exec tmux new -A -s main || exec "$SHELL" -l' \
      || fail "mosh to $host failed (mosh-server installed? UDP 60000-61000 open?)"
    ;;
  ssh)
    ssh -t "$host" "$remote_cmd" || fail "ssh to $host exited with an error"
    ;;
  *)
    fail "unknown REMOTE_TRANSPORT '$transport' (use et, mosh or ssh)"
    ;;
esac
