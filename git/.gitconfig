# ~/.gitconfig — stowed on Linux servers only (macOS keeps its own).
# user.name and user.email are NOT here; they're written per-machine to
# ~/.gitconfig.local by install.sh (see [include] at the bottom).

[user]
	signingkey = ~/.ssh/id_ed25519.pub

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

# Machine-specific overrides (not tracked): e.g. a different signing key path.
[include]
	path = ~/.gitconfig.local
